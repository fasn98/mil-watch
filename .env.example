# Telegram (crie o bot com @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Coleta
INTERVAL_SECONDS=90
API_SOURCES=https://api.adsb.lol/v2/mil,https://api.airplanes.live/v2/mil
DB_PATH=data/milwatch.db
LOG_PATH=data/milwatch.log
SESSION_GAP_MINUTES=30
# Dias de pontos brutos guardados (rotas resumidas e estatísticas ficam para sempre)
RAW_RETENTION_DAYS=30

# Alerta de entrada no Brasil: US | NATO | FOREIGN (todos menos BR) | ALL
BRAZIL_ALERT_SCOPE=US
ALERT_COOLDOWN_HOURS=6
# Eventos que vão para o Telegram: emergencia,anomalia,orbita,mudanca_rota,descida_rapida,sinal_perdido
ALERT_EVENTS=emergencia,anomalia
# Limita alertas de evento (exceto emergência) a estas regiões; vazio = todas
ALERT_EVENT_REGIONS=
# Regiões cujos eventos e anomalias ficam só no painel (sem Telegram)
ALERT_IGNORE_REGIONS=América do Norte,Alasca

# Índice de Atividade Anômala
ANOMALY_ALERT_Z=3.0
ANOMALY_MIN_DAYS=14
ANOMALY_BASELINE_DAYS=28

# Resumo diário (hora local; -1 desliga) e relatório do Brasil
DIGEST_HOUR=8
TIMEZONE=America/Sao_Paulo
REPORT_EVERY_DAYS=7

# Painel web
DASHBOARD_PORT=8088
DASHBOARD_BIND=0.0.0.0
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-esta-senha
